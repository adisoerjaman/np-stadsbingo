# Database (PostgreSQL via docker-compose)
DATABASE_URL="postgresql://myuser:mypassword@localhost:5433/mydb?schema=public"

# Geheim voor het verzegelen/ondertekenen van sessiecookies (iron-session).
# Minimaal 32 tekens. Genereer een nieuwe met:  openssl rand -base64 32
SESSION_SECRET="vervang-dit-door-een-willekeurige-string-van-minimaal-32-tekens"

# Fotopslag. "local" (default) schrijft naar ./uploads voor development.
# Zet op "vercel-blob" in productie en vul BLOB_READ_WRITE_TOKEN.
STORAGE_DRIVER="local"
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Bewaartermijn in dagen voor inzendingen + foto's (npm run db:cleanup).
RETENTION_DAYS="90"
